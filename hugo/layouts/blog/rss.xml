{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Title }} — {{ .Title }}</description>
    <language>{{ .Site.Language.LanguageCode }}</language>
    <generator>Hugo</generator>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{ range first 20 (sort (where .Pages "Type" "blog") "Date" "desc") }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Content | html }}</description>
      {{ with .Date }}<pubDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}
      {{ with .Params.tags }}{{ range . }}<category>{{ . }}</category>{{ end }}{{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
